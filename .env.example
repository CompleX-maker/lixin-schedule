# ── 后端 ────────────────────────────────────────────────────────
APP_ID=                   # 应用 ID
APP_SECRET=               # 应用密钥：用于派生「教务密码加密」与「会话签名」两把密钥
                          # 生成方式：openssl rand -base64 32
                          # ⚠️ 一旦更换，所有用户需重新登录，且已存的加密密码将无法解密

# ── 数据库 ──────────────────────────────────────────────────────
DATABASE_URL=             # mysql://user:password@host:port/dbname

# ── 前端（会通过 Vite 暴露到浏览器，不要放任何机密）────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth 服务地址
VITE_APP_ID=              # OAuth 应用 ID

# ── 后端认证 ────────────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth 服务地址（后端使用）
KIMI_OPEN_URL=            # Kimi 开放平台地址

# ── 管理员 ──────────────────────────────────────────────────────
OWNER_UNION_ID=           # 应用创建者的 Union ID，首次登录即获得 admin 角色
ADMIN_STUDENT_IDS=        # 逗号分隔的学号列表，这些账号也会被授予 admin

# ── 运行时 ──────────────────────────────────────────────────────
PORT=3000
